{% import 'elementor/macros' as m %}
{%- set wrapper_classes = settings.classes | merge( [ base_styles.base, 'lcake-main-wrapper' ] ) | join(' ') -%}
{%- set slider_classes = [ 'lcake-testimonial-slider', 'arrow_inside', 'lcake-atomic-testimonial' ] -%}
{%- if settings.show_dot -%}{%- set slider_classes = slider_classes | merge( [ 'lcake-slider-dotted' ] ) -%}{%- endif -%}

<div data-interaction-id="{{ interaction_id }}" class="{{ wrapper_classes }}" {{- m.render_custom_attributes(settings) }}>
    <div class="{{ slider_classes | join(' ') }}" data-config="{{ settings.data_config | e('html_attr') }}">
        <div class="lcake-main-swiper swiper" style="{{ settings.spacing_style }}">
            <div class="swiper-wrapper">
                {%- for item in settings.processed_items -%}
                    <div class="swiper-slide">
                        <div class="swiper-slide-inner">
                            {%- set tag = item.href is not empty ? 'a' : 'div' -%}
                            <{{ tag }} class="lcake-testimonial-item"
                                {%- if item.href is not empty %} href="{{ item.href | e('html_attr') }}"{% endif -%}
                                {%- if item.target is not empty %} target="{{ item.target | e('html_attr') }}"{% endif -%}>
                                <div class="lcake-single-testimonial-slider">
                                    {%- if item.logo_src is not empty -%}
                                        <div class="lcake-client-logo">
                                            {%- if item.logo_active_src is not empty -%}
                                                <img class="lcake-testimonial-client-active-logo lcake-client-logo-hover" src="{{ item.logo_active_src | e('html_attr') }}" alt="">
                                            {%- endif -%}
                                            <img class="lcake-testimonial-client-logo lcake-client-logo-default" src="{{ item.logo_src | e('html_attr') }}" alt="">
                                        </div>
                                    {%- endif -%}

                                    {%- if settings.quote_icon_enable and settings.quote_position == 'top' and settings.quote_icon.html is not empty -%}
                                        <span class="lcake-watermark-icon">{{ settings.quote_icon.html | raw }}</span>
                                    {%- endif -%}

                                    <div class="lcake-commentor-content">
                                        {%- if item.review is not empty -%}
                                            <p>{{ item.review | raw }}</p>
                                        {%- endif -%}

                                        {%- if settings.rating_enable -%}
                                            <ul class="lcake-stars">
                                                {%- for star in item.stars -%}
                                                    <li>{{ star | raw }}</li>
                                                {%- endfor -%}
                                            </ul>
                                        {%- endif -%}

                                        {%- if settings.title_separator -%}
                                            <span class="lcake-border-hr"></span>
                                        {%- endif -%}

                                        <div class="lcake-profile-info-row">
                                            {%- if item.photo_src is not empty -%}
                                                <div class="lcake-profile-image-card">
                                                    <img src="{{ item.photo_src | e('html_attr') }}" alt="{{ item.photo_alt | e('html_attr') }}">
                                                </div>
                                            {%- endif -%}
                                            <span class="lcake-profile-info">
                                                <strong class="lcake-author-name">{{ item.client_name }}</strong>
                                                {%- if item.designation is not empty %}<span class="lcake-author-des">{{ item.designation }}</span>{% endif -%}
                                            </span>
                                        </div>
                                    </div>

                                    {%- if settings.quote_icon_enable and settings.quote_position == 'bottom' and settings.quote_icon.html is not empty -%}
                                        <span class="lcake-watermark-icon">{{ settings.quote_icon.html | raw }}</span>
                                    {%- endif -%}
                                </div>
                            </{{ tag }}>
                        </div>
                    </div>
                {%- endfor -%}
            </div>

            {%- if settings.show_dot -%}
                <div class="swiper-pagination"></div>
            {%- endif -%}

            {%- if settings.show_arrow -%}
                <div class="swiper-navigation-button swiper-button-prev">{{ settings.left_arrow.html | raw }}</div>
                <div class="swiper-navigation-button swiper-button-next">{{ settings.right_arrow.html | raw }}</div>
            {%- endif -%}
        </div>
    </div>
</div>
