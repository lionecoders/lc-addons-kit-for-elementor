{% import 'elementor/macros' as m %}
{%- set wrapper_classes = settings.classes | merge( [ base_styles.base, 'lcake-lottie-wrapper' ] ) | join(' ') -%}

<div data-interaction-id="{{ interaction_id }}" class="{{ wrapper_classes }}" {{- m.render_custom_attributes(settings) }}>
    {%- if settings.lottie_url is not empty -%}
        <div class="lcake-lottie-container" id="{{ settings.container_id }}" data-lottie-config="{{ settings.lottie_config | e('html_attr') }}"></div>

        {%- if settings.show_controls -%}
            <div class="lcake-lottie-controls" data-target="{{ settings.container_id }}">
                <button class="lcake-lottie-play" aria-label="Play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></button>
                <button class="lcake-lottie-pause" aria-label="Pause"><svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg></button>
                <button class="lcake-lottie-stop" aria-label="Stop"><svg viewBox="0 0 24 24"><path d="M6 6h12v12H6z"/></svg></button>
                <button class="lcake-lottie-restart" aria-label="Restart"><svg viewBox="0 0 24 24"><path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z"/></svg></button>
            </div>
        {%- endif -%}
    {%- endif -%}
</div>
