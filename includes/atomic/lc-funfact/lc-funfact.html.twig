{% import 'elementor/macros' as m %}
{%- set outer_classes = settings.classes | merge( [ base_styles.base, 'lcake-wid-con' ] ) | join(' ') -%}

<div data-interaction-id="{{ interaction_id }}" class="{{ outer_classes }}" {{- m.render_custom_attributes(settings) }}>
    <div class="{{ settings.wrapper_class }}">
        {%- if settings.enable_vertical_border -%}
            <div class="vertical-bar {{ settings.vertical_border_position }}"></div>
        {%- endif -%}

        <div class="lcake-funfact-inner {{ settings.icon_position }}">
            {%- if settings.icon_type in [ 'icon', 'image_icon' ] -%}
                <div class="funfact-icon">
                    {%- if settings.icon_type == 'image_icon' and settings.icon_image_src is not empty -%}
                        <img src="{{ settings.icon_image_src | e('html_attr') }}" alt="{{ settings.icon_image_alt | e('html_attr') }}">
                    {%- endif -%}
                    {%- if settings.icon_type == 'icon' and settings.icon_switch and settings.icon.html is not empty -%}
                        <span class="lcake-funfact-icon">{{ settings.icon.html | raw }}</span>
                    {%- endif -%}
                </div>
            {%- endif -%}

            <div class="funfact-content">
                <div class="number-percentage-wraper">
                    {{- settings.number_prefix }}
                    <span class="number-percentage" data-value="{{ settings.number }}" data-animation-duration="{{ settings.animation_duration }}" data-style="{{ settings.style }}">0</span>
                    {{ settings.number_suffix -}}
                    {%- if settings.super_enable -%}
                        <span class="super">{{ settings.super_text }}</span>
                    {%- endif -%}
                </div>

                <{{ settings.title_tag }} class="funfact-title">{{ settings.title_text }}</{{ settings.title_tag }}>

                {%- if settings.show_overlay -%}
                    <div class="elementor-background-overlay lcake-funfact-overlay"></div>
                {%- endif -%}
            </div>
        </div>
    </div>
</div>
