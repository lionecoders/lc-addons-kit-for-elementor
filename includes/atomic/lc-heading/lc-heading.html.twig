{% import 'elementor/macros' as m %}
{%- set title_classes = settings.classes | merge( [ base_styles['heading-base'], 'lcake-heading-title' ] ) -%}
{%- set title_styles = '' -%}
{%- if settings.gradient_effect -%}
    {%- set title_classes = title_classes | merge( [ 'lcake-heading-gradient' ] ) -%}
    {%- set left_col = settings.gradient_color_left | default('#4f46e5') -%}
    {%- set right_col = settings.gradient_color_right | default('#ec4899') -%}
    {%- set title_styles = 'background: linear-gradient(to right, ' ~ left_col ~ ', ' ~ right_col ~ '); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; color: transparent;' -%}
{%- endif -%}
{%- set wrapper_classes = [ base_styles.base, 'lcake-heading' ] | join(' ') -%}
{%- set allowed_tags = '<b><strong><sup><sub><s><em><i><u><a><del><span><br>' -%}
<div data-interaction-id="{{ interaction_id }}" class="{{ wrapper_classes }}"
    {{- m.render_custom_attributes(settings) }}>
    <{{ settings.tag | e('html_tag') }} class="{{ title_classes | join(' ') }}"
        {% if title_styles is not empty %} style="{{ title_styles | e('html_attr') }}"{% endif %}>
        {{ settings.title | striptags(allowed_tags) | raw }}
    </{{ settings.tag | e('html_tag') }}>
</div>
