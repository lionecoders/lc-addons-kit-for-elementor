{% import 'elementor/macros' as m %}
{%- set wrapper_classes = settings.classes | merge( [ base_styles.base, 'lcake-main-wrapper' ] ) | join(' ') -%}
{%- set allowed_tags = '<b><strong><sup><sub><s><em><i><u><a><del><span><br>' -%}

<div data-interaction-id="{{ interaction_id }}" class="{{ wrapper_classes }}" {{- m.render_custom_attributes(settings) }}>
    <div class="lcake-single-pricing">
        <div class="lcake-pricing-header">
            {%- if settings.icon_type == 'image' and settings.image_src is not empty -%}
                <figure class="elementor-pricing-img"><img src="{{ settings.image_src | e('html_attr') }}" alt="{{ settings.image_alt | e('html_attr') }}"></figure>
            {%- endif -%}
            {%- if settings.icon_type == 'icon' and settings.icon_switch and settings.icon.html is not empty -%}
                <span class="lcake-pricing-icon elementkit-pricing-icon">{{ settings.icon.html | raw }}</span>
            {%- endif -%}
            {%- if settings.title is not empty -%}
                <{{ settings.title_tag }} class="lcake-pricing-title">{{ settings.title | striptags(allowed_tags) | raw }}</{{ settings.title_tag }}>
            {%- endif -%}
            {%- if settings.subtitle is not empty -%}
                <p class="lcake-pricing-subtitle">{{ settings.subtitle }}</p>
            {%- endif -%}
        </div>

        {%- if settings.currency is not empty and settings.price is not empty -%}
            <div class="lcake-pricing-price-wraper has-tag">
                <div class="lcake-pricing-tag"></div>
                <span class="lcake-pricing-price">
                    {%- if settings.currency_position == 'before' -%}<sup class="currency">{{ settings.currency }}</sup>{%- endif -%}
                    <span>{{ settings.price }}</span>
                    {%- if settings.currency_position == 'after' -%}<sup class="currency">{{ settings.currency }}</sup>{%- endif -%}
                    {%- if settings.duration is not empty -%}<sub class="period">{{ settings.duration }}</sub>{%- endif -%}
                </span>
            </div>
        {%- endif -%}

        <div class="lcake-pricing-content">
            {%- if settings.content_style == 'paragraph' -%}
                <p>{{ settings.content }}</p>
            {%- elseif settings.content_style == 'list' -%}
                <ul class="lcake-pricing-lists">
                    {%- for item in settings.processed_list_items -%}
                        <li>
                            {%- if item.icon_html is not empty -%}{{ item.icon_html | raw }}{%- endif -%}
                            {{ item.text }}
                            {%- if item.info is not empty -%}
                                <div class="lcake-pricing-list-info" data-info-tip="true">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16"><path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16m.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2"/></svg>
                                    <span></span>
                                    <p class="lcake-pricing-list-info-content" data-info-tip-content="true">{{ item.info }}</p>
                                </div>
                            {%- endif -%}
                        </li>
                    {%- endfor -%}
                </ul>
            {%- endif -%}
        </div>

        <div class="lcake-pricing-btn-wraper">
            <a {{- m.render_link_attributes(settings.btn_link) }} class="lcake-pricing-btn{% if settings.btn_class is not empty %} {{ settings.btn_class }}{% endif %} lcake-pricing-btn-icon-pos-{{ settings.btn_icon_align }}"{% if settings.btn_id is not empty %} id="{{ settings.btn_id | e('html_attr') }}"{% endif %}>
                {%- if settings.btn_icon_switch and settings.btn_icon_align == 'left' and settings.btn_icon.html is not empty -%}
                    {{ settings.btn_icon.html | raw }}
                {%- endif -%}
                {{ settings.btn_text }}
                {%- if settings.btn_icon_switch and settings.btn_icon_align == 'right' and settings.btn_icon.html is not empty -%}
                    {{ settings.btn_icon.html | raw }}
                {%- endif -%}
            </a>
        </div>
    </div>
</div>
